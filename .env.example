# =========================================================
# DataPilot Production Environment Configuration Example
# Copy this file to .env and customize values for your deployment.
# =========================================================

# LLM API Configuration (Groq / OpenAI compatible provider)
LLM_API_KEY=gsk_your_groq_api_key_here
LLM_MODEL=llama-3.3-70b-versatile
LLM_BASE_URL=https://api.groq.com/openai/v1

# Deployment Execution Mode
# Set to 'false' (default) to run in zero-dependency standalone mode with Synthetic Dev DB.
# Set to 'true' to connect to external MySQL, Qdrant, and Elasticsearch clusters.
ENABLE_EXTERNAL_SERVICES=false

# Application Server Port (Defaults to 8000; set by PaaS like Render, Railway, Cloud Run)
PORT=8000

# Data Warehouse Database (Only used if ENABLE_EXTERNAL_SERVICES=true)
DB_DW_HOST=localhost
DB_DW_PORT=3306
DB_DW_USER=datapilot
DB_DW_PASSWORD=datapilot_password
DB_DW_DATABASE=dw

# Metadata Database (Only used if ENABLE_EXTERNAL_SERVICES=true)
DB_META_HOST=localhost
DB_META_PORT=3306
DB_META_USER=datapilot
DB_META_PASSWORD=datapilot_password
DB_META_DATABASE=meta

# Qdrant Vector Store (Only used if ENABLE_EXTERNAL_SERVICES=true)
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Elasticsearch Full-Text Index (Only used if ENABLE_EXTERNAL_SERVICES=true)
ES_HOST=localhost
ES_PORT=9200

# Text Embedding Inference Service (Only used if ENABLE_EXTERNAL_SERVICES=true)
EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
